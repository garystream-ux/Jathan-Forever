{
  "name": "jathan-forever",
  "version": "0.1.0",
  "private": true,
  "description": "Jathan Forever — the shared travel journal of Ethan Highfield & Jacob Monroe.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "cd game && npm ci && npm run build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "pin": "powershell -NoProfile -Command \"foreach ($d in @('node_modules','.next')) { if (Test-Path $d) { attrib +P /S /D \"$d\\*\"; attrib +P $d } }; Write-Output 'Pinned node_modules and .next on-device.'\""
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "lenis": "^1.1.18",
    "motion": "^11.11.17",
    "next": "^14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "yet-another-react-lightbox": "^3.21.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
