# ── Site ─────────────────────────────────────────────────────────────
# Absolute base URL, used for canonical links, sitemap, and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://jathanforever.com

# ── Giscus comments (GitHub Discussions) ─────────────────────────────
# Get these from https://giscus.app after enabling Discussions on your repo.
# All four are required for comments to render (otherwise a friendly
# placeholder shows instead). See the README "Comments" section.
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ── Mapbox (optional, future) ────────────────────────────────────────
# Only needed if you follow the "SWAP POINT — Mapbox GL" note in
# components/RouteMap.tsx to switch from OpenStreetMap to Mapbox tiles.
# NEXT_PUBLIC_MAPBOX_TOKEN=
